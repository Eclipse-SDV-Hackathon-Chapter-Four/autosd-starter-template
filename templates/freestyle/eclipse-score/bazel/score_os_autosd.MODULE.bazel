bazel_dep(name = "os_autosd", version = "0.0.0")
git_override(
    module_name = "os_autosd",
    commit = "de75f4a26352c1f3272546857a4471f97f83683a",
    remote = "https://github.com/eclipse-score/os_autosd.git",
)

# AutoSD GCC Toolchain Setup
autosd_10_gcc = use_extension("@os_autosd//toolchain/autosd_10_gcc:extensions.bzl", "autosd_10_gcc_extension")

## Add more flags as needed
autosd_10_gcc.configure(
    c_flags = ["-fPIC"],
    cxx_flags = ["-fPIC"],
)
use_repo(autosd_10_gcc, "autosd_10_gcc_repo")
