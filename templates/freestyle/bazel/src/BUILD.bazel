load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Build C binary
cc_binary(
    name = "hello",
    srcs = [
        ":hello.c"
    ],
)

pkg_tar(
    name = "hello_pkg_tar",
    srcs = [":hello"],
    package_dir = "/usr/bin",
    mode = "0755",
    visibility = ["//visibility:public"],
  )
